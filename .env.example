# Copy to .env for local runs, or set these as Railway variables.
MONGO_URL=mongodb://127.0.0.1:27017   # Railway: ${{MongoDB.MONGO_URL}}
MONGO_DB=anumaan_v4
NODE_ENV=production                   # marks the session cookie Secure
DEMO_PASSWORD=anumaan                 # password for every seeded demo account
AUTO_SEED=true                        # seed demo data when the database is empty
# PORT is set by Railway automatically
